; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[admob]

general/ios/enabled=false

[application]

config/name="Pawnic"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.12, 0.13, 0.17, 1)
boot_splash/image="res://assets/icon/frame/icon.png"
config/icon="res://assets/icon/icon.png"

[autoload]

Tuning="*res://scripts/autoload/tuning.gd"
SaveStore="*res://scripts/autoload/save_store.gd"
Localization="*res://scripts/autoload/localization.gd"
Skins="*res://scripts/autoload/skins.gd"
Boards="*res://scripts/autoload/boards.gd"
Iap="*res://scripts/autoload/iap.gd"
Ads="*res://scripts/autoload/ads.gd"
Sound="*res://scripts/autoload/sound.gd"
Music="*res://scripts/autoload/music.gd"
GameSpeed="*res://scripts/autoload/game_speed.gd"
Difficulty="*res://scripts/autoload/difficulty.gd"
PlayerColor="*res://scripts/autoload/player_color.gd"

[debug]

gdscript/warnings/untyped_declaration=2

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=486
window/size/window_height_override=864
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[editor_plugins]

enabled=PackedStringArray("res://addons/GodotGooglePlayBilling/plugin.cfg", "res://addons/admob/plugin.cfg", "res://addons/portrait_feature/plugin.cfg")

[gui]

theme/custom="res://themes/ui_theme.tres"

[input_devices]

pointing/emulate_touch_from_mouse=true

[internationalization]

locale/translations=PackedStringArray("res://data/translations.tr.translation", "res://data/translations.en.translation", "res://data/translations.de.translation", "res://data/translations.es.translation", "res://data/translations.fr.translation", "res://data/translations.it.translation", "res://data/translations.pt.translation", "res://data/translations.id.translation")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.12, 0.13, 0.17, 1)
