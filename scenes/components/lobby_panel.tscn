[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/lobby_panel.gd" id="1"]

[node name="LobbyPanel" type="VBoxContainer"]
theme_override_constants/separation = 12
script = ExtResource("1")

[node name="PlayersLabel" type="Label" parent="."]
layout_mode = 2
theme_type_variation = &"PanelLabel"
text = "LOBBY_PLAYERS"

[node name="Seats" type="VBoxContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 8

[node name="ColorLabel" type="Label" parent="."]
layout_mode = 2
theme_type_variation = &"PanelLabel"
text = "YOUR_COLOR"

[node name="Colors" type="HBoxContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2
