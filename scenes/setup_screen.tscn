layout_mode = 2
theme_type_variation = &"IconButton"

[node name="Arrow" type="Control" parent="Box/Header/BackButton"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("3")

[node name="Heading" type="Label" parent="Box/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"HeadingLabel"
text = "NEW_GAME"

[node name="TopSpace" type="Control" parent="Box"]
layout_mode = 2
size_flags_vertical = 3
mouse_filter = 2

[node name="Options" type="PanelContainer" parent="Box"]
layout_mode = 2
theme_type_variation = &"OptionsPanel"

[node name="Box" type="VBoxContainer" parent="Box/Options"]
layout_mode = 2

[node name="ModeButton" type="Button" parent="Box/Options/Box"]
