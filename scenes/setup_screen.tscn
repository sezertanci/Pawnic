[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/ui/setup_screen.gd" id="1"]
[ext_resource type="PackedScene" path="res://scenes/components/stepper.tscn" id="2"]
[ext_resource type="Script" path="res://scripts/ui/back_arrow.gd" id="3"]

[node name="SetupScreen" type="MarginContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_type_variation = &"WideMargin"
script = ExtResource("1")

[node name="Box" type="VBoxContainer" parent="."]
layout_mode = 2
mouse_filter = 2

[node name="Header" type="HBoxContainer" parent="Box"]
layout_mode = 2
theme_override_constants/separation = 20

[node name="BackButton" type="Button" parent="Box/Header"]
unique_name_in_owner = true
